# =================================================================
# 🌱 AgriShield AI - Environment Configuration Template
# =================================================================
# Instructions:
# 1. Copy this file and rename it to `.env`:
#    cp .env.example .env  (Linux/Mac) or copy .env.example .env (Windows)
# 2. Fill in your valid API keys and configuration secrets below.
# 3. DO NOT commit your actual `.env` file to version control.
# =================================================================

# -----------------------------------------------------------------
# 🔐 Application Security & Authentication
# -----------------------------------------------------------------
# Secret key used for cryptographic signing of JWT tokens and session cookies
SECRET_KEY=your_super_secret_jwt_and_session_key_here_min_32_chars

# -----------------------------------------------------------------
# 🤖 AI & LLM Advisory Engine (Groq Cloud)
# Get your API key from: https://console.groq.com/
# -----------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# -----------------------------------------------------------------
# 🌾 Real-Time Agmarknet Mandi Commodity Prices (Data.gov.in)
# Register and get an API key at: https://data.gov.in/
# -----------------------------------------------------------------
GOV_API_KEY=your_datagov_api_key_here
AGMARKNET_API_KEY=your_datagov_api_key_here
RESOURCE_ID=9ef842fd-dd9f-47b5-8c6d-96ed0ea74e7e

# -----------------------------------------------------------------
# ☀️ Weather & Climate Intelligence (OpenWeatherMap)
# Get a free API key at: https://openweathermap.org/api
# -----------------------------------------------------------------
WEATHER_API_KEY=your_openweathermap_api_key_here

# -----------------------------------------------------------------
# 📱 SMS Notification & Advisory Dispatch (Twilio)
# Create an account at: https://www.twilio.com/
# -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------
# ⛓️ Solana Blockchain & Parametric Insurance Pool
# -----------------------------------------------------------------
# Solana Network RPC Endpoint (Devnet, Testnet, or Mainnet)
SOLANA_RPC_URL=https://api.devnet.solana.com

# -----------------------------------------------------------------
# 🌿 FloraScan AI Model Weights (Optional Override)
# -----------------------------------------------------------------
# Optional custom path to PyTorch weights file (defaults to pest and disease/plant_disease_model.pth)
# PLANT_DISEASE_MODEL_PATH=./pest and disease/plant_disease_model.pth
